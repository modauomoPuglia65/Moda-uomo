<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Test Moda Uomo</title>
<style>
  body{font-family:sans-serif;padding:20px;background:#f5f3ef;}
  .btn{background:#b8860b;color:#fff;padding:14px 20px;border:none;border-radius:10px;font-size:16px;cursor:pointer;display:block;width:100%;margin-bottom:10px;}
  .box{background:#fff;border-radius:12px;padding:16px;margin-bottom:10px;border:1px solid #ddd;}
  #result{background:#e8f5e9;border-radius:10px;padding:14px;margin-top:10px;font-size:14px;display:none;}
</style>
</head>
<body>
<div class="box">
  <h2 style="color:#b8860b;margin-bottom:16px;">🧪 Test JavaScript</h2>
  <button class="btn" id="btn1">1. Tocca qui per testare</button>
  <button class="btn" id="btn2">2. Apri popup</button>
  <button class="btn" id="btn3">3. Salva in memoria</button>
  <div id="result"></div>
</div>

<div class="box" id="popup" style="display:none;border:2px solid #b8860b;">
  <h3>✅ Il popup funziona!</h3>
  <p>JavaScript funziona correttamente.</p>
  <button class="btn" id="closePopup">Chiudi</button>
</div>

<script>
  function showResult(msg) {
    const el = document.getElementById('result');
    el.style.display = 'block';
    el.textContent = msg;
  }

  document.getElementById('btn1').addEventListener('click', function() {
    showResult('✅ JavaScript funziona! Ora prova il pulsante 2.');
  });

  document.getElementById('btn2').addEventListener('click', function() {
    document.getElementById('popup').style.display = 'block';
  });

  document.getElementById('closePopup').addEventListener('click', function() {
    document.getElementById('popup').style.display = 'none';
  });

  document.getElementById('btn3').addEventListener('click', function() {
    try {
      localStorage.setItem('test', 'OK');
      const v = localStorage.getItem('test');
      showResult('✅ LocalStorage: ' + v);
    } catch (e) {
      showResult('❌ LocalStorage non supportato o accesso negato.');
    }
  });
</script>
</body>
</html>
